{
  "name": "fitnesswynk-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "node-pg-migrate --envPath .env.local --migration-filename-format index up",
    "migrate:down": "node-pg-migrate --envPath .env.local --migration-filename-format index down",
    "migrate:new": "node-pg-migrate --envPath .env.local --migration-filename-format index create -j sql",
    "migrate:fake": "node-pg-migrate --envPath .env.local --migration-filename-format index up --fake",
    "migrate:status": "node-pg-migrate --envPath .env.local --migration-filename-format index up --dry-run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.100.11",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
